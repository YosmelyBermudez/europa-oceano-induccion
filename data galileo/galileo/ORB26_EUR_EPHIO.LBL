      2000-01-03T18:30:00."                                                   
                                                                              
^TABLE                        = "ORB26_EUR_EPHIO.TAB"                         
OBJECT                        = TABLE                                         
  INTERCHANGE_FORMAT          = ASCII                                         
  ROWS                        = 10909                                         
  COLUMNS                     = 8                                             
  ROW_BYTES                   = 96                                            
  DESCRIPTION                 = "                                             
      This ASCII table contains MAG and trajectory data in Europa             
      Phi-Omega (EPHIO) coordinates.  In EPHIO coordinates X is in the        
      direction of corotational flow (System III Phi). Z is parallel to the   
      Jovian spin axis (Omega). Y completes the right handed set. The basis   
      vectors are fixed at the time of Europa closest approach                
      (2000-01-03 17:59:44). Positions are given in units of Europa radii     
      where RE = 1560 km."                                                    
                                                                              
  OBJECT                      = COLUMN                                        
    NAME                      = "SPACECRAFT EVENT TIME"                       
    COLUMN_NUMBER             = 1                                             
    UNIT                      = "N/A"                                         
